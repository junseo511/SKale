# Server-only secret. Never prefix this value with VITE_.
# AI calls stay blocked unless this is explicitly changed to true.
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173

# Set this only when the frontend and API are deployed on different origins.
# Example: https://skale-api.onrender.com
VITE_API_BASE_URL=
